GRAFANA_URL=http://localhost:3000
GRAFANA_API_TOKEN=replace_with_token

# Optional: org ID if your Grafana uses multiple orgs
GRAFANA_ORG_ID=1

# Optional: override default timeout in seconds
HTTP_TIMEOUT=20

# Datasource UIDs used by dashboard JSON files
DS_PROMETHEUS=prometheus
DS_LOKI=loki
DS_TEMPO=tempo

# Needed when rendering datasource provisioning template
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
TEMPO_URL=http://tempo.monitoring.svc.cluster.local:3200

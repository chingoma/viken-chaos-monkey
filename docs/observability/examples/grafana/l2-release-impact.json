{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Error Ratio by Version",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{service=\"$service\",status=~\"5..\"}[5m])) by (version) / sum(rate(http_server_requests_seconds_count{service=\"$service\"}[5m])) by (version)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 Latency by Version",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, version) (rate(http_server_requests_seconds_bucket{service=\"$service\"}[5m])))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Restart Trend by Version",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"$service.*\"}[30m])) by (pod)" }
      ]
    }
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["tier:l2", "class:triage", "release", "change-risk"],
  "templating": {
    "list": [
      { "name": "namespace", "label": "namespace", "type": "query", "query": "label_values(kube_pod_info, namespace)", "refresh": 1 },
      { "name": "service", "label": "service", "type": "query", "query": "label_values(http_server_requests_seconds_count, service)", "refresh": 1 }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "[L2] Release Impact - Did Change Break Reliability?",
  "uid": "obs_l2_release_impact",
  "version": 1
}

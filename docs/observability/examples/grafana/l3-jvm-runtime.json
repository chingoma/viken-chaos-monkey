  "templating": {
    "list": [
      { "name": "service", "label": "service", "type": "query", "query": "label_values(jvm_memory_used_bytes, service)", "refresh": 1 }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "[L3] Service <service> JVM - Is Runtime Saturated?",

{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Deployment Desired vs Available",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=~\"$service\"}" },
        { "refId": "B", "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=~\"$service\"}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HPA Desired vs Current",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\"}" },
        { "refId": "B", "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Restarts and Probe Failures",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[15m])) by (pod)" },
        { "refId": "B", "expr": "sum(rate(kube_pod_container_status_ready{namespace=\"$namespace\",condition=\"false\"}[5m])) by (pod)" }
      ]
    }
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["tier:l3", "class:triage", "kubernetes", "env-aware"],
  "templating": {
    "list": [
      { "name": "namespace", "label": "namespace", "type": "query", "query": "label_values(kube_deployment_spec_replicas, namespace)", "refresh": 1 },
      { "name": "service", "label": "service", "type": "textbox", "query": "" }
    ]
  },

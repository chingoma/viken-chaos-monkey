  },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "/runbooks/platform/$service/general"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=\"$service\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "RPS",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",service=\"$service\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{environment=\"$environment\",service=\"$service\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Error Ratio (5xx)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"$environment\",service=\"$service\"}[5m])))",
          "refId": "A"
        }
      ],
      "title": "p95 Latency",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m])) / sum(rate(container_cpu_cfs_periods_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "CPU Throttling Ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",service=\"$service\"}[5m])) by (route, method)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "title": "Traffic by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",service=\"$service\",status=~\"5..\"}[5m])) by (route, method) / sum(rate(http_server_requests_seconds_count{environment=\"$environment\",service=\"$service\"}[5m])) by (route, method)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "title": "Error Ratio by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, method) (rate(http_server_requests_seconds_bucket{environment=\"$environment\",service=\"$service\"}[5m])))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "title": "p95 by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8,
      "targets": [
        {
          "expr": "max(hikaricp_connections_pending{service=\"$service\"})",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "increase(hikaricp_connections_timeout_total{service=\"$service\"}[5m])",
          "legendFormat": "timeouts_5m",
          "refId": "B"
        }
      ],
      "title": "DB Pool Health (Hikari)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "tier:l3",
    "class:triage",
    "template",
    "env-aware"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
        },
        "label": "environment",
        "name": "environment",
        "query": "label_values(http_server_requests_seconds_count, environment)",
        "refresh": 1,
        "type": "query"
      },
      {
        "label": "cluster",
        "name": "cluster",
        "query": "label_values(http_server_requests_seconds_count{environment=\"$environment\"}, cluster)",
        "refresh": 1,
        "type": "query"
      },
      {
        "label": "namespace",
        "name": "namespace",
        "query": "label_values(http_server_requests_seconds_count{environment=\"$environment\",cluster=\"$cluster\"}, namespace)",
        "refresh": 1,
        "type": "query"
      },
      {
        "label": "service",
        "name": "service",
        "query": "label_values(http_server_requests_seconds_count{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\"}, service)",
        "refresh": 1,
        "type": "query"
      },
      {
        "hide": 0,
        "includeAll": true,
        "label": "pod",
        "name": "pod",
        "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "[L3] Service <service> - Why Is It Failing?",
  "uid": "obs_l3_service_health_template",
  "version": 1
}
